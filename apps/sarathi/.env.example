# Required: set these three before `docker compose up`
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me
SARATHI_MODELS=gpt-4o-mini,gpt-4o

SECRET_KEY=replace-me
DATABASE_URL=postgresql+psycopg://sarathi:sarathi@db:5432/sarathi
UPLOAD_DIR=/data/uploads
BRAVE_API_KEY=
CORS_ORIGINS=http://localhost:3000

# Optional: leave commented out to disable
# EMBEDDING_MODEL=text-embedding-3-small
# SARATHI_CONTEXT_WINDOW=128000
# WEB_PROXY=http://user:pass@host:port
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 pk:sk>
# OTEL_SERVICE_NAME=sarathi
# OTEL_RESOURCE_ATTRIBUTES=service.environment=production
# TELEMETRY_CAPTURE_CONTENT=true

POSTGRES_USER=sarathi
POSTGRES_PASSWORD=sarathi
POSTGRES_DB=sarathi

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=replace-me
NEXTAUTH_URL=http://localhost:3000
API_URL_INTERNAL=http://backend:8000
