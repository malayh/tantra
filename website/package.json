{
  "name": "tantra-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-old-urls.mjs",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "astro": "7.4.0",
    "astro-expressive-code": "0.44.2",
    "starlight-links-validator": "0.27.0"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1"
  },
  "prettier": {
    "printWidth": 120,
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
