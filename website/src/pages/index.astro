    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--tt-surface-1);
    border: 1px solid var(--tt-border);
    border-radius: 8px;
    padding: 10px 10px 10px 14px;
    font-family: var(--tt-font-mono);
    font-size: 14px;
  }

  .install .sigil {
    color: var(--tt-text-faint);
    user-select: none;
  }

  .install code {
    flex: 1;
    min-width: 0;
    font-family: inherit;
    white-space: nowrap;
    overflow-x: auto;
    color: var(--tt-text-strong);
  }

  button.copy {
    appearance: none;
    border: 1px solid var(--tt-border);
    background: var(--tt-surface-2);
    color: var(--tt-text-muted);
    font-family: var(--tt-font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 9px;
    border-radius: 5px;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  button.copy:hover {
    color: var(--tt-text-strong);
    border-color: var(--tt-border-strong);
  }

  button.copy[data-done="1"] {
    color: var(--tt-accent);
    border-color: var(--tt-accent);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      filter 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .btn.primary {
    background: var(--tt-gradient);
    color: var(--tt-on-accent);
  }

  .btn.primary:hover {
    filter: brightness(1.08);
  }

  .btn.ghost {
    border-color: var(--tt-border);
    color: var(--tt-text-muted);
  }

  .btn.ghost:hover {
    border-color: var(--tt-border-strong);
    color: var(--tt-text-strong);
  }

  .code {
    margin: 56px 0 0;
  }

  .note {
    margin: 16px 2px 0;
    font-size: 13.5px;
    color: var(--tt-text-faint);
  }

  .note code {
    font-family: var(--tt-font-mono);
    color: var(--tt-text-muted);
  }

  .pitch {
    padding-top: 96px;
  }

  h2.sect {
    margin: 0 0 30px;
    font-family: var(--tt-font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tt-text-faint);
    font-weight: 500;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--tt-border);
    border: 1px solid var(--tt-border);
    border-radius: 12px;
    overflow: hidden;
  }

  .card {
    background: var(--tt-bg);
    padding: 28px 26px 30px;
  }

  .card h3 {
    margin: 0 0 10px;
    color: var(--tt-text-strong);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .card h3::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 10px;
    border-radius: 2px;
    background: var(--tt-gradient);
    vertical-align: middle;
  }

  .card p {
    margin: 0;
    font-size: 14.5px;
    color: var(--tt-text-muted);
  }

  .card code {
    font-family: var(--tt-font-mono);
    font-size: 12.8px;
    color: var(--tt-text-strong);
    background: var(--tt-surface-1);
    border: 1px solid var(--tt-border);
    border-radius: 4px;
    padding: 1px 5px;
  }

  .card.wide {
    grid-column: 1 / -1;
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 56px;
    }

    .code {
      margin-top: 40px;
    }

    .pitch {
      padding-top: 68px;
    }

    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .install,
    .btn {
      width: 100%;
    }

    .btn {
      justify-content: center;
    }
  }
</style>
