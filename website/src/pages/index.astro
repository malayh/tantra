---
import { Code } from "astro-expressive-code/components";
import Marketing from "../layouts/Marketing.astro";
import { withBase } from "../lib/url";

const sample = `import asyncio
from uuid import uuid4

from tantra import Agent, OpenAICompatible, Runtime, SQLiteStore
from tantra.extratools.web import web_search


class Researcher(Agent):
    model = "gpt-5"
    prompt = "Answer with current, sourced information."
    tools = [web_search(api_key=BRAVE_API_KEY)]


async def main() -> None:
    store = SQLiteStore("sessions.db")
    await store.setup()
    runtime = Runtime(
        OpenAICompatible("https://api.openai.com/v1", OPENAI_API_KEY),
        store,
        [Researcher],
    )
    root_id = await runtime.create(Researcher)
    async with runtime.connect(root_id, writable=True) as connection:
        result = await connection.prompt(
            "What changed in Python 3.13?", command_id=uuid4()
        )
    print(result.text)
    await runtime.aclose()


asyncio.run(main())`;
---

<Marketing
  title="tantra — the agent turn loop as a library"
  description="tantra is a Python agent actor runtime with durable journals, FIFO inboxes, parallel tools, typed asks, and independent subagents."
>
  <div class="site-wrap hero">
    <p class="eyebrow">Python agent runtime</p>
    <h1>
      The agent turn loop,
      <br />
      as a <em>library</em>.
    </h1>
    <p class="lede">
      tantra owns the actor loop — durable input, sampling, parallel tools, live approvals, subagents, compaction and
      journals — so your agent stays a declaration instead of a framework.
    </p>

    <div class="cta">
      <div class="install">
        <span class="sigil">$</span>
        <code id="install-cmd">pip install tantra-harness</code>
        <button class="copy" type="button" data-copy="install-cmd">
          Copy
        </button>
      </div>
      <a class="btn primary" href={withBase("docs/")}>
        Read the docs
      </a>
      <a class="btn ghost" href="https://github.com/malayh/tantra">
        GitHub
      </a>
    </div>

    <div class="code">
      <Code code={sample} lang="py" title="researcher.py" />
    </div>
    <p class="note">
      <code>Connection.prompt(...)</code> accepts one durable UUID command and returns its terminal result. Use{" "}
      <code>send(...)</code> plus event iteration when you need streaming.
    </p>
  </div>

  <section class="pitch site-wrap">
    <h2 class="sect">Why</h2>
    <div class="grid">
      <div class="card">
        <h3>The loop is the library</h3>
        <p>
          The Runtime activates actors. Tools, hooks, skills and memory plug into it. You write an <code>Agent</code> —
          values and function references — not an orchestration layer.
        </p>
      </div>
      <div class="card">
        <h3>Durable actor journals</h3>
        <p>
          Every agent has a FIFO inbox and independent scalar cursor. Live asks suspend one actor; crashes interrupt
          in-flight work without repeating model calls or tools.
        </p>
      </div>
      <div class="card">
        <h3>One engine, many drivers</h3>
        <p>
          A CLI, an HTTP server and a background worker share one <code>Runtime</code>. Readers never own execution, and
          a newer writable connection replaces the previous writer.
        </p>
      </div>
      <div class="card">
        <h3>Declarative, FastAPI-style</h3>
        <p>
          Tools are built by factories — <code>web_search(api_key=...)</code> — in your own module. Keys are per-agent
          and a misconfiguration fails at construction, not mid-turn. The library never reads the environment.
        </p>
      </div>
      <div class="card wide">
        <h3>Tools ship as extras</h3>
        <p>
          The base install is <code>pydantic</code>, <code>httpx</code>, <code>openai</code> — plus stdlib{" "}
          <code>bash</code> and <code>ShellGuard</code>. <code>[web]</code> adds <code>web_search</code> and{" "}
          <code>web_fetch</code>; <code>[doc]</code> adds <code>read_doc</code>; <code>[postgres]</code> adds the driver{" "}
          <code>PostgresStore</code> needs. Nothing you did not ask for is imported.
        </p>
      </div>
    </div>
  </section>
</Marketing>

<script>
  document.querySelectorAll<HTMLButtonElement>("button.copy").forEach((button) => {
    button.addEventListener("click", () => {
      const source = document.getElementById(button.dataset.copy ?? "");
      navigator.clipboard.writeText(source?.textContent ?? "").then(
        () => {
          button.textContent = "Copied";
          button.dataset.done = "1";
          setTimeout(() => {
            button.textContent = "Copy";
            delete button.dataset.done;
          }, 1600);
        },
        () => {
          button.textContent = "Copy failed";
          setTimeout(() => {
            button.textContent = "Copy";
          }, 1600);
        },
      );
    });
  });
</script>

<style>
  :global(body)::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      900px 420px at 15% -10%,
      color-mix(in srgb, var(--tt-orange) 12%, transparent),
      transparent 70%
    );
    z-index: 0;
  }

  .hero {
    padding-top: 88px;
    padding-bottom: 24px;
  }

  .eyebrow {
    font-family: var(--tt-font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tt-accent);
    margin: 0 0 22px;
  }

  h1 {
    margin: 0;
    color: var(--tt-text-strong);
    font-size: clamp(1.85rem, 6vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 600;
  }

  h1 em {
    font-style: normal;
    background: var(--tt-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lede {
    margin: 22px 0 0;
    max-width: 60ch;
    font-size: clamp(1rem, 2.4vw, 1.15rem);
    color: var(--tt-text-muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 34px;
  }

